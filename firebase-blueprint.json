{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer entity representing a client of El-Naggar Furniture Factory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique customer ID" },
        "name": { "type": "string", "description": "Customer full name", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "description": "Customer phone number", "pattern": "^[0-9+\\-\\s]{8,20}$" },
        "address": { "type": "string", "description": "Customer delivery address", "maxLength": 255 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone"]
    },
    "JobOrder": {
      "title": "JobOrder",
      "description": "Job order document for custom furniture production",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Job order ID" },
        "order_number": { "type": "string", "description": "Unique order reference number e.g. JO-2026-0101", "maxLength": 50 },
        "customer_id": { "type": "string", "description": "Reference to customer ID" },
        "room_model_code": { "type": "string", "description": "Room or model code", "maxLength": 100 },
        "contract_date": { "type": "string", "description": "Contract date YYYY-MM-DD" },
        "delivery_date": { "type": "string", "description": "Delivery date YYYY-MM-DD" },
        "general_specs": { "type": "string", "description": "General furniture specifications", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Draft", "قيد التشغيل", "تم التنفيذ", "تسليم"] },
        "current_stage": {
          "type": "string",
          "enum": [
            "لم يبدأ",
            "نجارة عفش",
            "نجارة انتريهات",
            "خدمة وتجهيز",
            "كابينة أستر",
            "كابينة دوكو",
            "تنجيد",
            "تشطيب وتغليف",
            "جاهز للتسليم"
          ]
        },
        "stage_updated_at": { "type": "string", "format": "date-time" },
        "is_archived": { "type": "boolean" },
        "total_price": { "type": "number", "description": "Total contract value" },
        "deposit_paid": { "type": "number", "description": "Deposit amount paid" },
        "delivery_receipt_id": { "type": "string", "description": "Linked delivery receipt ID" },
        "delivery_receipt_number": { "type": "string", "description": "Linked delivery receipt number" },
        "delivered_at": { "type": "string", "description": "Actual delivery date YYYY-MM-DD" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "order_number", "customer_id", "room_model_code", "status"]
    },
    "JobDetail": {
      "title": "JobDetail",
      "description": "Detailed workshop dimensions, paint, and upholstery specs for a job order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "job_order_id": { "type": "string" },
        "dimensions_cm": { "type": "string", "description": "Detailed dimensions in cm", "maxLength": 500 },
        "wood_type": { "type": "string", "description": "Wood type", "maxLength": 100 },
        "paint_details": { "type": "string", "description": "Paint details", "maxLength": 500 },
        "fabric_source": { "type": "string", "description": "Fabric supplier/source", "maxLength": 100 },
        "color_code": { "type": "string", "description": "Fabric color code", "maxLength": 100 },
        "batch_number": { "type": "string", "description": "Fabric batch number", "maxLength": 100 },
        "installation_notes": { "type": "string", "description": "Site installation notes", "maxLength": 500 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "job_order_id", "dimensions_cm", "paint_details", "fabric_source", "batch_number"]
    },
    "Attachment": {
      "title": "Attachment",
      "description": "Attached images including CAD drawings, fabric swatch tags, and 3D renders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "job_order_id": { "type": "string" },
        "file_type": { "type": "string", "enum": ["drawing", "fabric_sample", "3d_render", "other"] },
        "file_url": { "type": "string", "description": "Image URL or data URL" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "uploaded_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "job_order_id", "file_type", "file_url", "title"]
    },
    "DeliveryReceipt": {
      "title": "DeliveryReceipt",
      "description": "Official customer delivery acceptance receipt linked to one or more job orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique delivery receipt ID" },
        "receipt_number": { "type": "string", "description": "Sequential delivery receipt number e.g. DR-2026-0001", "maxLength": 50 },
        "customer_id": { "type": "string", "description": "Linked customer ID" },
        "customer_name": { "type": "string", "maxLength": 120 },
        "customer_phone": { "type": "string", "maxLength": 40 },
        "receipt_date": { "type": "string", "description": "Delivery receipt date YYYY-MM-DD" },
        "order_ids": { "type": "array", "description": "Linked job order IDs" },
        "order_numbers": { "type": "array", "description": "Linked job order numbers" },
        "total_contract_value": { "type": "number" },
        "total_deposit_paid": { "type": "number" },
        "remaining_balance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "receipt_number", "customer_id", "receipt_date", "order_ids"]
    },
    "TruckManifest": {
      "title": "TruckManifest",
      "description": "Delivery truck cargo manifest and driver loading sheet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripDate": { "type": "string" },
        "tripDay": { "type": "string" },
        "driverName": { "type": "string" },
        "truckNumber": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tripDate", "items"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authorized ERP user account and RBAC role record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "accounting", "operations", "sales"] },
        "isActive": { "type": "boolean" },
        "isDelegatedManager": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "isActive"]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Pending administrator-issued invite keyed by lowercase email until user's first Firebase Auth login",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "accounting", "operations", "sales"] },
        "isActive": { "type": "boolean" },
        "isDelegatedManager": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["email", "name", "role", "isActive"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only security and business audit trail entry",
      "type": "object",
      "properties": {
        "user_uid": { "type": "string" },
        "user_email": { "type": "string" },
        "user_role": { "type": "string", "enum": ["admin", "accounting", "operations", "sales"] },
        "action": { "type": "string" },
        "entity_type": { "type": "string" },
        "entity_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      },
      "required": ["user_uid", "action", "entity_type", "entity_id", "timestamp"]
    },
    "OrderCounter": {
      "title": "OrderCounter",
      "description": "Yearly atomic sequence counter for JO-YYYY-XXXX generation",
      "type": "object",
      "properties": {
        "year": { "type": "number" },
        "last_sequence": { "type": "number" },
        "updated_at": { "type": "string" }
      },
      "required": ["year", "last_sequence"]
    },
    "FactorySettings": {
      "title": "FactorySettings",
      "description": "Central factory configuration, branches, and numbering prefixes",
      "type": "object",
      "properties": {
        "factoryName": { "type": "string" },
        "factorySubtitle": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "branchesList": { "type": "array" },
        "orderNumberPrefix": { "type": "string" },
        "receiptNumberPrefix": { "type": "string" },
        "enableUrgentAlerts": { "type": "boolean" },
        "defaultTaxRate": { "type": "number" },
        "updated_at": { "type": "string" }
      },
      "required": ["factoryName", "orderNumberPrefix", "receiptNumberPrefix"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Collection storing customer profiles"
    },
    "/job_orders/{jobOrderId}": {
      "schema": { "$ref": "#/entities/JobOrder" },
      "description": "Collection storing job orders"
    },
    "/job_orders/{jobOrderId}/job_details/{detailId}": {
      "schema": { "$ref": "#/entities/JobDetail" },
      "description": "Subcollection storing detailed workshop specifications"
    },
    "/job_orders/{jobOrderId}/attachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/Attachment" },
      "description": "Subcollection storing attached image drawings and swatch tags"
    },
    "/delivery_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/DeliveryReceipt" },
      "description": "Collection storing issued customer delivery receipts linked to job orders"
    },
    "/truck_manifests/{manifestId}": {
      "schema": { "$ref": "#/entities/TruckManifest" },
      "description": "Collection storing truck cargo manifests"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection storing RBAC user profiles keyed by Firebase Auth UID"
    },
    "/user_invites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Collection storing pending admin-provisioned invites keyed by lowercase email"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only audit log entries readable by administrators"
    },
    "/order_counters/{counterId}": {
      "schema": { "$ref": "#/entities/OrderCounter" },
      "description": "Transactional sequence counters for job order numbers"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/FactorySettings" },
      "description": "Central factory configuration documents"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Job Orders Collection
    match /job_orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Truck Manifests Collection ("حمولة العربية")
    match /truck_manifests/{manifestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Delivery Receipts Collection ("إقرار استلام العميل")
    match /delivery_receipts/{receiptId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Users Collection (RBAC & Profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Smart Saved Queries Collection
    match /smart_queries/{queryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
